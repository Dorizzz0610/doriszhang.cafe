{
  "name": "personal-page",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf .next",
    "dev": "next dev",
    "dev:clean": "npm run clean && next dev",
    "build": "node scripts/build-douban-json.mjs && node scripts/generate-nasa-data.js && next build",
    "start": "next start",
